{
	"name": "bedloop",
	"version": "0.2.0-beta.1",
	"type": "module",
	"description": "TypeScript client for Bedloop API",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"playground": "bun playground/playground.ts",
		"check": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun typecheck && bun check && bun run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/bun": "1.4.2",
		"@types/node": "26.6.4",
		"tsup": "8.5.1",
		"tsx": "4.23.15",
		"typescript": "5.9.3"
	},
	"keywords": [
		"bedloop",
		"api",
		"client",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/johan12361/bedloop.git"
	},
	"bugs": {
		"url": "https://github.com/johan12361/bedloop/issues"
	},
	"homepage": "https://github.com/johan12361/bedloop#readme",
	"author": "johan12361",
	"license": "MIT",
	"dependencies": {
		"axios": "1.20.0"
	}
}
